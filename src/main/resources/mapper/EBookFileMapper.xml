<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.intellibookmallapi.mapper.EBookFileMapper">
    
    <!-- 电子书文件结果映射 -->
    <resultMap id="EBookFileResultMap" type="org.example.intellibookmallapi.entity.EBookFile">
        <id column="file_id" property="fileId" />
        <result column="book_id" property="bookId" />
        <result column="file_format" property="fileFormat" />
        <result column="file_path" property="filePath" />
        <result column="file_size" property="fileSize" />
        <result column="download_count" property="downloadCount" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>
    
    <!-- 基础查询字段 -->
    <sql id="Base_Column_List">
        file_id, book_id, file_format, file_path, file_size, download_count, create_time, update_time
    </sql>
    
    <!-- 根据书籍ID查询所有文件 -->
    <select id="selectByBookId" resultMap="EBookFileResultMap">
        SELECT 
            <include refid="Base_Column_List" />
        FROM tb_ebook_file
        WHERE book_id = #{bookId}
        ORDER BY create_time DESC
    </select>
    
    <!-- 根据文件ID查询 -->
    <select id="selectByPrimaryKey" resultMap="EBookFileResultMap">
        SELECT 
            <include refid="Base_Column_List" />
        FROM tb_ebook_file
        WHERE file_id = #{fileId}
    </select>
    
    <!-- 根据书籍ID和格式查询 -->
    <select id="selectByBookIdAndFormat" resultMap="EBookFileResultMap">
        SELECT 
            <include refid="Base_Column_List" />
        FROM tb_ebook_file
        WHERE book_id = #{bookId} AND UPPER(file_format) = UPPER(#{format})
    </select>
    
</mapper>
